# Public: Supabase project URL and anon key (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required for narrow RPCs that guard quota and persist results.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Never link this Gemini project to billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_ENABLED=false
GEMINI_FREE_TIER_CONFIRMED=false
DAILY_AI_LIMIT=10
# Hard server ceiling is 2 MB after compression; original client file <=5 MB.
MAX_IMAGE_SIZE_MB=2
